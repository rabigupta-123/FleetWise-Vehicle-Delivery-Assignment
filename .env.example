# FleetWise Configuration
DATABASE_PATH=fleetwise.db
APP_ENV=development
HOST=127.0.0.1
PORT=8000
HTTPS_PORT=8443

# Session Security (Cryptographically strong secret key, minimum 32 characters)
SESSION_SECRET_KEY=generate_a_cryptographically_secure_random_key_min_32_chars

# Insecure Dev Mode (Disabled by default; set to 1 only for local development without authentication)
# FLEETWISE_INSECURE_DEV=0

# User Management & First-run Bootstrap:
# Initial users are provisioned via CLI:
#   python scripts/create_user.py --role ops_lead --username admin
#   python scripts/create_user.py --role dispatcher
#   python scripts/create_user.py --role fleet_manager
